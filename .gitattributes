# Text normalization
* text=auto
# Godot text formats
*.gd text
*.tscn text
*.tres text
*.import text
*.cfg text
*.md text
*.json text
# Binary Godot scenes/resources — .scn/.res are binary-serialised PackedScene
# and Resource. Without these lines `* text=auto` applies CRLF normalisation
# and corrupts them on checkout.
*.scn binary
*.res binary
# Binary assets
*.glb binary
*.fbx binary
*.blend binary
*.png binary
*.jpg binary
*.exr binary
*.wasm binary
*.dll binary
*.so binary
*.dylib binary
