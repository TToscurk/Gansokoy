{
  "_doc": "MQ10 第一站。小鈴話快、好奇心強，害怕只維持半句；她不是功能型借書員。最後保留『不該存在的書』作後續鉤子。",
  "start": [
    { "if": "met_kosuzu", "node": "repeat_1" },
    { "node": "k1" }
  ],
  "nodes": {
    "k1": { "speaker": "kosuzu", "portrait": "surprised", "text": "「歡迎——哇，你真的帶著刀。」", "next": "k2" },
    "k2": { "speaker": "yoriichi", "portrait": "normal", "text": "「……真的？」", "next": "k3" },
    "k3": { "speaker": "kosuzu", "portrait": "smile", "text": "「村口傳得比你走得快。有人說你一刀能劈開鳥居。」", "next": "k4" },
    "k4": { "speaker": "yoriichi", "portrait": "serious", "text": "「我不會劈鳥居。」", "next": "k5" },
    "k5": { "speaker": "kosuzu", "portrait": "smile", "text": "「太好了。那塊匾很貴。」", "next": "k6" },
    "k6": { "speaker": "yoriichi", "portrait": "normal", "text": "「慧音老師要我還書。」", "next": "k7" },
    "k7": { "speaker": "kosuzu", "portrait": "normal", "text": "「放這裡。寺子屋的書總是沾粉筆灰，一聞就知道。」", "next": "k8" },
    "k8": { "speaker": "kosuzu", "portrait": "surprised", "text": "「你真是從外面來的？外面現在流行這種耳飾嗎？」", "next": "k9" },
    "k9": { "speaker": "yoriichi", "portrait": "sad", "text": "「我不知道。」", "next": "k10" },
    "k10": { "speaker": "kosuzu", "portrait": "normal", "text": "「不知道從哪裡來，也不知道自己為什麼來？」", "next": "k11" },
    "k11": { "speaker": "kosuzu", "portrait": "smile", "text": "「那你來對地方了。書最會替人記得。」", "next": "k12",
             "quest_event": { "type": "TALK", "target": "kosuzu_lending" } },
    "k12": { "speaker": "kosuzu", "portrait": "normal", "text": "「鈴奈庵有妖怪的書、外面的書，還有幾本——」", "next": "k13" },
    "k13": { "speaker": "kosuzu", "portrait": "smile", "text": "「照理說，不該存在的書。」", "next": "k14" },
    "k14": { "speaker": "yoriichi", "portrait": "surprised", "text": "「請讓我看。」", "next": "k15" },
    "k15": { "speaker": "kosuzu", "portrait": "surprised", "text": "「……你連客套都不會嗎？」", "next": null },

    "repeat_1": { "speaker": "kosuzu", "portrait": "smile", "text": "「今天想找哪一種？妖怪、外界，還是你自己？」", "next": null,
                  "quest_event": { "type": "TALK", "target": "kosuzu_lending" } }
  }
}