[gd_scene load_steps=2 format=3]

; 存讀檔選單。3 槽，鍵盤操作（↑↓ 選、Enter 確定、Esc 關）。
;
; 版面刻意與 world_map.tscn 一致：CanvasLayer + 全螢幕 Dim + 置中面板，
; 標題色 (0.95, 0.85, 0.6)。槽位是三個實體 Slot 節點（不是繪製出來的），
; 每個都能單獨選取與調整。

[ext_resource type="Script" path="res://ui/save/save_menu.gd" id="1"]

